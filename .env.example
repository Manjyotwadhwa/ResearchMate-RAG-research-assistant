# Copy to .env and fill in. NEVER commit .env.
GROQ_API_KEY=your_groq_api_key_here

# Any chat model available on your Groq account (names change over time; check the Groq console)
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Local embedding model (downloaded once from Hugging Face)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_RELEVANCE_SCORE=0.0

# Upload limits
MAX_FILE_SIZE_MB=20
MAX_FILES=10
MAX_PAGES_PER_FILE=300
MIN_TEXT_CHARS=100

# Safety / budgets
MAX_QUESTION_CHARS=1000
ANALYSIS_MAX_CONTEXT_CHARS=12000
